# ============================================================
# DEV environment only. This suite logs in and — later — creates
# and deletes real resources. Never point it at production.
# utils/prodGuard.ts refuses to run against any non-dev host.
#
# Copy this file to .env and fill in real values.
# .env is gitignored; never commit real credentials.
# ============================================================

# SaaS dashboard — DEV host (NOT chat.paicloud.ai, which is prod)
SAAS_URL=https://chat-dev.paicloud.ai

# SaaS login — must be an account that belongs to the noctocode.dev org,
# since that org holds the fixtures the specs depend on.
SAAS_EMAIL=your-saas-email-here
SAAS_PASSWORD=your-saas-password-here

# Dedicated throwaway account for the logout tests. Logging THIS account out
# must never touch the shared session's token — that's the whole point.
SAAS_LOGOUT_EMAIL=your-logout-account-email-here
SAAS_LOGOUT_PASSWORD=your-logout-account-password-here