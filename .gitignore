# Dependencies
node_modules/

# Environment / secrets
.env
.env.*
!.env.example

# Reports — deny everything, always.
# Sessions (live tokens), login screenshots, and any debug output land here.
# Deny-all means a new artifact can never leak into git again.
reports/*
!reports/.gitkeep

# Playwright output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# TypeScript
dist/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/